[
  {
  "name": "workspaces",
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 5,
  "reload_on_style_change": true,
  "modules-center": ["hyprland/workspaces"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "persistent-workspaces": {
      "*": [ 1, 2, 3, 4, 5, 6, 7, 8 ]
    },
    "format-icons": {
        "1": "", 
        "2": "", 
        "3": "", 
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "(⌐■_■)",
    },
  },
  "sway/mode": {
    "format": "{}"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 50
  },
},
{
  "name": "systemtray",
  "layer": "bottom",
  "position": "bottom",
  "height": 34,
  "spacing": 5,
  "modules-center": ["group/systemtray"],
  "group/systemtray": {
      "orientation": "horizontal",
      "modules": ["hyprland/language","cpu","memory","clock","tray","pulseaudio",],
    },
  "cpu": { 
    "interval": 10, 
    "format": ": {usage}%" 
  },
  "memory": {
    "interval": 30,
    "format": ": {percentage}%",
  },
  "clock": {
    "format": "{:%Y/%m/%d %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
}
]
